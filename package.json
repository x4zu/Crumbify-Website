{
  "name": "crumbify-website",
  "version": "1.3.0",
  "private": true,
  "description": "Crumbify — a warm, modern bakery website template built with Next.js, React and Tailwind CSS.",
  "author": "Reivan Elsyafir Pratama",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/x4zu/Crumbify-Website.git"
  },
  "homepage": "https://github.com/x4zu/Crumbify-Website",
  "keywords": [
    "bakery",
    "website-template",
    "nextjs",
    "react",
    "tailwindcss",
    "landing-page"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "assets:crop": "node scripts/crop-assets.mjs",
    "assets:cutout": "node scripts/cutout-assets.mjs",
    "bones": "boneyard-js build http://localhost:3000 --out src/bones --breakpoints 375,768,1024,1280,1440,1920 --wait 2500 --force --no-scan"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "boneyard-js": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.6.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
